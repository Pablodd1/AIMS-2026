# AIMS-2026 Backend Environment Variables Template
# Copy this file to .env and populate real values (NEVER commit .env)

PORT=4000
NODE_ENV=production
CLINIC_TZ=America/New_York
CLINIC_NAME=Innovative Medical Wellness
FRONTEND_URL=https://aimedicalscriber.com

# MongoDB Connection
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Authentication
JWTSECRET=replace_with_strong_random_secret

# OpenAI Clinical Scribe / Realtime Voice
OPENAI_KEY=sk-...
# Optional faster/alternate scribe model override (default: gpt-4o-mini)
AIMS_SCRIBE_MODEL=gpt-4o-mini

# Twilio SMS Reminders
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# SMTP Mail (Nodemailer fallback)
EMAIL_USER=
EMAIL_PASS=

# AWS S3 Presigned Document Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
AWS_BUCKET_NAME=
PUBLIC_BUCKET_AWS_URL=

# Cloudinary (Consent PDF/image capture & document cleanup)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Internal Service-to-Service Key (payments bridge / cron)
AIMS_INTERNAL_KEY=

# Local upload storage path override (defaults to /home/aims/uploads on VPS or ./uploads locally)
# AIMS_UPLOAD_ROOT=./uploads

# Automated Jev Error Monitoring (scripts/jev-audit.mjs)
TYPESAFE_API_KEY=
RESEND_API_KEY=
NOTIFICATION_EMAIL=
WEBHOOK_ALERT_URL=
